# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Datasets and generated artifacts (regenerable via the pipeline, not source)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# Notebook checkpoints
.ipynb_checkpoints/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Env files
.env
.env.local

# OS
.DS_Store

# iCloud placeholders
*.icloud
